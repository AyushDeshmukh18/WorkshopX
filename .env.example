# ==============================================================================
# FirstBuild Engine - Environment Configuration Template
# Copy this file to .env.local and populate the values.
# NEVER commit .env.local or real credentials to version control.
# ==============================================================================

# Client Variables (Public)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FirstBuild Engine
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-Only Database Access (NEVER expose to client)
SUPABASE_SECRET_KEY=

# AI Providers (Server Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Email Provider Configuration (Server Only: brevo | resend | smtp)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME="FirstBuild Workshop"
EMAIL_FROM_ADDRESS=
EMAIL_DAILY_LIMIT=250

# Telegram Admin Notification Bot (Server Only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# External API Integrations (Server Only)
GITHUB_TOKEN=
PAGESPEED_API_KEY=

# Security & Session Management (Server Only)
# SESSION_SECRET must be at least 32 characters/bytes for cryptographic signing
SESSION_SECRET=
CRON_SECRET=
ADMIN_EMAILS=
IP_HASH_SALT=
COMMUNITY_INVITE_URL=
