{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/tick",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "app/api/submissions/route.ts": {
      "maxDuration": 30
    },
    "app/api/blueprints/route.ts": {
      "maxDuration": 30
    },
    "app/api/certificate/[id]/route.ts": {
      "maxDuration": 30
    },
    "app/api/cron/digest/route.ts": {
      "maxDuration": 60
    }
  }
}
